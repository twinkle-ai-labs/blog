---
import '../styles/global.css';
import Aurora from '../components/Aurora.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { STAR_DATA_URI } from '../lib/star';
import { SITE, GA_MEASUREMENT_ID } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** 글 페이지면 og:type=article */
  article?: boolean;
  lang?: string;
  /** 이 장의 나눔 카드 — 안 주면 이 집의 기본 카드가 선다. */
  image?: string;
  /**
   * 이 장의 **정본 주소**. 안 주면 지금 주소를 쓴다.
   *
   * 구 Pelican 의 주소를 그대로 지키느라 어떤 장은 `.html` 로 끝난다(`/archives.html`).
   * 그런데 `Astro.url.pathname` 은 그런 장도 «/archives/» 로 다듬어 내놓아,
   * 정본이 **없는 주소**를 가리키고 있었다 — 정본이 404 면 그 장은 색인에서 사라진다.
   */
  path?: string;
  /** 아직 보일 것이 아닌 장(초안·숨김·404). 검색 목록에 올리지 않는다. */
  noindex?: boolean;
  /** 글의 때와 손길 — `og:type=article` 일 때만 나간다. */
  published?: Date;
  updated?: Date;
  author?: string;
  tags?: string[];
  /** 기계가 읽는 표(JSON-LD). 장마다 제 것을 짓는다. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = SITE.description,
  article = false,
  lang = SITE.lang,
  image = '/og/default.png',
  noindex = false,
  published,
  updated,
  author = SITE.author,
  tags = [],
  jsonLd,
  path,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(path ?? Astro.url.pathname, SITE.url).href;
/* 나눔 카드의 주소는 **절대 주소**여야 한다 — 긁어 가는 쪽은 우리 도메인을 모른다. */
const ogImage = new URL(image, SITE.url).href;

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={STAR_DATA_URI} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/atom+xml" title={SITE.name} href="/feeds/all.atom.xml" />

    {noindex && <meta name="robots" content="noindex, follow" />}
    {/* 검색 결과의 미리보기를 우리가 줄이지 않는다 — 기본값은 짧게 자르는 쪽이다. */}
    {!noindex && (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : lang} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    {article && published && <meta property="article:published_time" content={published.toISOString()} />}
    {article && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {article && <meta property="article:author" content={author} />}
    {article && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    {/* 큰 카드로 — 요약 한 줄짜리 작은 카드는 우리가 구운 그림을 손톱만 하게 만든다. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />

    {/* 화면이 그려지기 전에 테마를 정한다 — 늦으면 흰 화면이 한 번 번쩍인다.
        저장된 선택이 있을 때만 굳히고, 없으면 시스템을 따른다. */}
    <script is:inline>
      (function () {
        try {
          var match = document.cookie.match(/(?:^|; )twinkle-theme=(dark|light)(?:;|$)/);
          var t = match && match[1];
          if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    {
      import.meta.env.PROD && GA_MEASUREMENT_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          ></script>
          <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', GA_MEASUREMENT_ID);
          </script>
        </>
      )
    }
  </head>
  <body>
    {/* 하늘은 어느 화면에나 걸린다. */}
    <Aurora />

    <Header />

    <main class="shell">
      <slot />
    </main>

    <Footer />
    <SearchModal />

    {/* 맨 위로 — 한참 내려온 뒤에만 선다 */}
    <button class="to-top" type="button" hidden aria-label="맨 위로">
      <span aria-hidden="true">↑</span>
    </button>

    {/* 맨 위로 — 단추가 이 레이아웃의 것이라 그 움직임도 여기 산다. */}
    <script>
      // ---- 맨 위로 — 한 화면쯤 내려왔을 때부터 보인다 ----
      const toTop = document.querySelector<HTMLButtonElement>('.to-top');
      if (toTop) {
        const reveal = () => {
          const shown = window.scrollY > window.innerHeight * 0.8;
          toTop.hidden = !shown;
          toTop.classList.toggle('is-shown', shown);
        };
        reveal();
        window.addEventListener('scroll', reveal, { passive: true });

        toTop.addEventListener('click', () => {
          // 덜 움직이길 원하는 사람에게는 애니메이션 없이 보낸다
          const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' });
        });
      }
    </script>
  </body>
</html>
