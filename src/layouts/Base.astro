---
import '../styles/global.css';
import Aurora from '../components/Aurora.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { STAR_PATH } from '../lib/star';
import { SITE, GA_MEASUREMENT_ID } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** 글 페이지면 og:type=article */
  article?: boolean;
  lang?: string;
  /** 이 장의 나눔 카드 — 안 주면 이 집의 기본 카드가 선다. */
  image?: string;
  /**
   * 이 장의 **정본 주소**. 안 주면 지금 주소를 쓴다.
   *
   * 구 Pelican 의 주소를 그대로 지키느라 어떤 장은 `.html` 로 끝난다(`/archives.html`).
   * 그런데 `Astro.url.pathname` 은 그런 장도 «/archives/» 로 다듬어 내놓아,
   * 정본이 **없는 주소**를 가리키고 있었다 — 정본이 404 면 그 장은 색인에서 사라진다.
   */
  path?: string;
  /** 아직 보일 것이 아닌 장(초안·숨김·404). 검색 목록에 올리지 않는다. */
  noindex?: boolean;
  /** 글의 때와 손길 — `og:type=article` 일 때만 나간다. */
  published?: Date;
  updated?: Date;
  author?: string;
  tags?: string[];
  /** 기계가 읽는 표(JSON-LD). 장마다 제 것을 짓는다. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = SITE.description,
  article = false,
  lang = SITE.lang,
  image = '/og/default.png',
  noindex = false,
  published,
  updated,
  author = SITE.author,
  tags = [],
  jsonLd,
  path,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(path ?? Astro.url.pathname, SITE.url).href;
/* 나눔 카드의 주소는 **절대 주소**여야 한다 — 긁어 가는 쪽은 우리 도메인을 모른다. */
const ogImage = new URL(image, SITE.url).href;

/* 파비콘 — 브랜드의 별(StarMark), Aurora Ledger 의 보라 그라데이션으로. */
const FAVICON =
  'data:image/svg+xml,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><linearGradient id="g" x1="14" y1="86" x2="86" y2="14" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#7040D9"/><stop offset="1" stop-color="#8550E4"/></linearGradient></defs><path fill="url(#g)" d="${STAR_PATH}"/></svg>`,
  );
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={FAVICON} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/atom+xml" title={SITE.name} href="/feeds/all.atom.xml" />

    {noindex && <meta name="robots" content="noindex, follow" />}
    {/* 검색 결과의 미리보기를 우리가 줄이지 않는다 — 기본값은 짧게 자르는 쪽이다. */}
    {!noindex && (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : lang} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    {article && published && <meta property="article:published_time" content={published.toISOString()} />}
    {article && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {article && <meta property="article:author" content={author} />}
    {article && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    {/* 큰 카드로 — 요약 한 줄짜리 작은 카드는 우리가 구운 그림을 손톱만 하게 만든다. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />

    {/* 화면이 그려지기 전에 테마를 정한다 — 늦으면 흰 화면이 한 번 번쩍인다.
        저장된 선택이 있을 때만 굳히고, 없으면 시스템을 따른다. */}
    <script is:inline>
      (function () {
        try {
          var match = document.cookie.match(/(?:^|; )twinkle-theme=(dark|light)(?:;|$)/);
          var t = match && match[1];
          if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    {
      import.meta.env.PROD && GA_MEASUREMENT_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          ></script>
          <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', GA_MEASUREMENT_ID);
          </script>
        </>
      )
    }
  </head>
  <body>
    {/* 하늘은 어느 화면에나 걸린다. */}
    <Aurora />

    <Header />

    <main class="shell">
      <slot />
    </main>

    <Footer />
    <SearchModal />

    {/* 맨 위로 — 한참 내려온 뒤에만 선다 */}
    <button class="to-top" type="button" hidden aria-label="맨 위로">
      <span aria-hidden="true">↑</span>
    </button>

    <script>
      import { createStore } from 'redux';

      // ---- 테마 토글 — Redux가 화면 상태를 맡고 쿠키가 사이트 사이 선택을 공유한다 ----
      const KEY = 'twinkle-theme';
      const root = document.documentElement;
      const media = window.matchMedia('(prefers-color-scheme: dark)');

      type Theme = 'dark' | 'light';
      const cookieTheme = document.cookie.match(/(?:^|; )twinkle-theme=(dark|light)(?:;|$)/)?.[1] as Theme | undefined;
      const initialTheme: Theme = cookieTheme ?? (media.matches ? 'dark' : 'light');
      const themeStore = createStore((state: Theme = initialTheme, action: { type: string; payload?: Theme }) =>
        action.type === 'theme/set' && action.payload ? action.payload : state,
      );

      function effectiveTheme(): 'dark' | 'light' {
        return themeStore.getState();
      }

      function paintToggle() {
        const icon = document.querySelector('.theme-toggle .icon');
        if (icon) icon.textContent = effectiveTheme() === 'dark' ? '☾' : '☀';
      }

      document.querySelector('[data-action="theme"]')?.addEventListener('click', () => {
        const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
        themeStore.dispatch({ type: 'theme/set', payload: next });
      });

      themeStore.subscribe(() => {
        const theme = themeStore.getState();
        root.setAttribute('data-theme', theme);
        const domain = location.hostname.endsWith('twinklelabs.kr') ? '; Domain=.twinklelabs.kr' : '';
        document.cookie = `${KEY}=${theme}; Path=/; Max-Age=31536000; SameSite=Lax${domain}`;
        paintToggle();
        // 남의 판(iframe)도 같이 갈아입어야 한다 — 듣는 쪽은 각자 알아서
        document.dispatchEvent(new CustomEvent('twinkle:theme', { detail: theme }));
      });
      root.setAttribute('data-theme', initialTheme);
      paintToggle();

      const siteHeader = document.querySelector('.site-header');
      const updateHeader = () => siteHeader?.classList.toggle('is-scrolled', window.scrollY > 0);
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });

      // ---- 모바일 메뉴 서랍 ----
      const menu = document.querySelector<HTMLElement>('[data-role="menu"]');
      const menuBtn = document.querySelector<HTMLElement>('[data-action="menu-open"]');
      const menuPanel = menu?.querySelector<HTMLElement>('.menu-sheet__panel');

      function openMenu() {
        if (!menu) return;
        menu.hidden = false;
        // 다음 프레임에 켜야 «닫힌 자리»가 한 번 그려진다 — 아니면 서랍이 이미 열린 채 나타난다.
        requestAnimationFrame(() => menu.classList.add('is-open'));
        menuBtn?.setAttribute('aria-expanded', 'true');
        document.body.classList.add('is-locked');
      }

      function closeMenu() {
        if (!menu || menu.hidden) return;
        menu.classList.remove('is-open');
        menuBtn?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('is-locked');
        const hide = () => { menu.hidden = true; menuPanel?.removeEventListener('transitionend', hide); };
        menuPanel?.addEventListener('transitionend', hide);
      }

      menuBtn?.addEventListener('click', openMenu);
      document.querySelector('[data-role="menu-backdrop"]')?.addEventListener('click', closeMenu);
      // 길을 고르면 서랍은 제 할 일을 끝냈다.
      menuPanel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      // 화면이 넓어지면 가로줄 메뉴가 돌아온다 — 서랍이 남아 있을 이유가 없다.
      window.matchMedia('(min-width: 40em)').addEventListener('change', (e) => { if (e.matches) closeMenu(); });

      // ---- 검색 모달 ----
      const modal = document.querySelector<HTMLElement>('[data-role="search-modal"]');
      const input = document.querySelector<HTMLInputElement>('#search-input');
      const list = document.querySelector<HTMLUListElement>('#search-results');
      const empty = document.querySelector<HTMLElement>('[data-role="search-empty"]');
      const indexEl = document.querySelector('#search-index');

      type Doc = { title: string; url: string; category: string; tags: string[]; summary: string; date: string };
      const docs: Doc[] = indexEl ? JSON.parse(indexEl.textContent || '[]') : [];
      let active = -1;

      function openSearch() {
        if (!modal) return;
        modal.hidden = false;
        document.body.classList.add('is-locked');
        input?.focus();
        input?.select();
        render(input?.value ?? '');
      }

      function closeSearch() {
        if (!modal) return;
        modal.hidden = true;
        document.body.classList.remove('is-locked');
      }

      function render(q: string) {
        if (!list || !empty) return;
        const query = q.trim().toLowerCase();
        const hits = !query
          ? docs.slice(0, 8)
          : docs.filter((d) =>
              [d.title, d.category, d.summary, d.tags.join(' ')].join(' ').toLowerCase().includes(query),
            );
        active = -1;
        list.innerHTML = hits
          .map(
            (d) => `
            <li>
              <a href="${d.url}">
                <div class="r-title">${escapeHtml(d.title)}</div>
                <div class="r-meta">${escapeHtml(d.category)} · ${escapeHtml(d.date)}</div>
              </a>
            </li>`,
          )
          .join('');
        empty.hidden = hits.length > 0;
      }

      function escapeHtml(s: string) {
        return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
      }

      function move(delta: number) {
        if (!list) return;
        const items = [...list.querySelectorAll('li')];
        if (!items.length) return;
        active = (active + delta + items.length) % items.length;
        items.forEach((li, i) => li.classList.toggle('is-active', i === active));
        items[active]?.scrollIntoView({ block: 'nearest' });
      }

      document.querySelector('[data-action="search-open"]')?.addEventListener('click', openSearch);
      document.querySelector('[data-role="search-backdrop"]')?.addEventListener('click', closeSearch);
      document.querySelector('[data-role="search-close"]')?.addEventListener('click', closeSearch);
      // 결과를 고르면 모달은 제 할 일을 끝냈다 — 뒤판의 잠금도 함께 풀린다.
      list?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) closeSearch(); });
      input?.addEventListener('input', () => render(input.value));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu?.hidden) { closeMenu(); return; }
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          modal?.hidden ? openSearch() : closeSearch();
          return;
        }
        if (modal?.hidden) return;
        if (e.key === 'Escape') closeSearch();
        if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
        if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
        if (e.key === 'Enter' && active >= 0) {
          const link = list?.querySelectorAll('li')[active]?.querySelector('a');
          if (link) { e.preventDefault(); location.href = link.href; }
        }
      });

      // ---- 맨 위로 — 한 화면쯤 내려왔을 때부터 보인다 ----
      const toTop = document.querySelector<HTMLButtonElement>('.to-top');
      if (toTop) {
        const reveal = () => {
          const shown = window.scrollY > window.innerHeight * 0.8;
          toTop.hidden = !shown;
          toTop.classList.toggle('is-shown', shown);
        };
        reveal();
        window.addEventListener('scroll', reveal, { passive: true });

        toTop.addEventListener('click', () => {
          // 덜 움직이길 원하는 사람에게는 애니메이션 없이 보낸다
          const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' });
        });
      }
    </script>
  </body>
</html>
