---
import type { Post } from '../lib/posts';
import { postUrl, categoryOf, categoryName, formatDate, slugify } from '../lib/posts';

interface Props {
  post: Post;
  /** 목록 안 제목 레벨 */
  headingLevel?: 'h2' | 'h3';
  featured?: boolean;
  index?: number;
}

const { post, headingLevel: Heading = 'h2', featured = false, index } = Astro.props;
const category = categoryOf(post);
---

<li class:list={{ 'featured-post': featured }}>
  <a class:list={['post-card', { 'post-card--featured': featured }]} href={postUrl(post)}>
    {index && <span class="post-card__number" aria-hidden="true">{String(index).padStart(2, '0')}</span>}
    {featured && <span class="post-card__label">Featured story</span>}
    <div class="post-card__content">
      <div class="post-card__meta">
        <span class="chip chip--brand">{categoryName(category)}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </div>
      <Heading>{post.data.title}</Heading>
      {post.data.summary && <p class="post-card__summary">{post.data.summary}</p>}
      {post.data.tags.length > 0 && (
        <div class="post-card__tags">
          {post.data.tags.map((tag) => (
            <span class="chip">#{slugify(tag)}</span>
          ))}
        </div>
      )}
    </div>
    <span class="arrow" aria-hidden="true">읽기 <b>↗</b></span>
  </a>
</li>
