---
// 모든 페이지에서 헤더 아래에 표시하는 스크롤 진행도.
---

<span class="header-progress" aria-hidden="true"></span>

<script>
  const progress = document.querySelector<HTMLElement>('.header-progress');
  const header = document.querySelector<HTMLElement>('.site-header');
  let frame = 0;
  const updateProgress = () => {
    frame = 0;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const fraction = max > 0 ? Math.max(0, Math.min(1, window.scrollY / max)) : 0;
    if (progress) progress.style.transform = `scaleX(${fraction})`;
    header?.classList.toggle('is-scrolled', window.scrollY > 0);
  };
  const scheduleProgress = () => {
    if (!frame) frame = requestAnimationFrame(updateProgress);
  };
  updateProgress();
  window.addEventListener('scroll', scheduleProgress, { passive: true });
  window.addEventListener('resize', scheduleProgress, { passive: true });
  new ResizeObserver(scheduleProgress).observe(document.body);
</script>
