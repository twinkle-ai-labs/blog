---
import { getPublishedPosts, postUrl, categoryOf, categoryName, formatDate } from '../lib/posts';

// 사이트가 작아 전 글을 인라인 JSON 인덱스로 싣는다 (구 테마와 같은 방식)
const posts = await getPublishedPosts();
const index = posts.map((post) => ({
  title: post.data.title,
  url: postUrl(post),
  category: categoryName(categoryOf(post)),
  tags: post.data.tags,
  summary: post.data.summary,
  date: formatDate(post.data.date),
}));
---

<div class="search-modal" data-role="search-modal" hidden>
  <div class="search-modal__backdrop" data-role="search-backdrop"></div>
  <div class="search-modal__panel" role="dialog" aria-modal="true" aria-label="글 검색">
    <div class="search-modal__field">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input type="text" id="search-input" placeholder="글 검색…" autocomplete="off" aria-label="검색어" />
      <button type="button" class="search-modal__close" data-role="search-close" aria-label="검색 닫기">
        <kbd>ESC</kbd>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <ul class="search-modal__results" id="search-results"></ul>
    <p class="search-modal__empty" data-role="search-empty" hidden>검색 결과가 없어요. 다른 검색어로 시도해보세요.</p>
  </div>
</div>

<script type="application/json" id="search-index" set:html={JSON.stringify(index)} />

{/* 검색의 움직임 — 여는 단추는 머리띠에 살지만, 무엇이 열리고 어떻게 찾는가는 이 조각의 것이다. */}
<script>
      // ---- 검색 모달 ----
      const modal = document.querySelector<HTMLElement>('[data-role="search-modal"]');
      const input = document.querySelector<HTMLInputElement>('#search-input');
      const list = document.querySelector<HTMLUListElement>('#search-results');
      const empty = document.querySelector<HTMLElement>('[data-role="search-empty"]');
      const indexEl = document.querySelector('#search-index');

      type Doc = { title: string; url: string; category: string; tags: string[]; summary: string; date: string };
      const docs: Doc[] = indexEl ? JSON.parse(indexEl.textContent || '[]') : [];
      let active = -1;

      function openSearch() {
        if (!modal) return;
        modal.hidden = false;
        document.body.classList.add('is-locked');
        input?.focus();
        input?.select();
        render(input?.value ?? '');
      }

      function closeSearch() {
        if (!modal) return;
        modal.hidden = true;
        document.body.classList.remove('is-locked');
      }

      function render(q: string) {
        if (!list || !empty) return;
        const query = q.trim().toLowerCase();
        const hits = !query
          ? docs.slice(0, 8)
          : docs.filter((d) =>
              [d.title, d.category, d.summary, d.tags.join(' ')].join(' ').toLowerCase().includes(query),
            );
        active = -1;
        list.innerHTML = hits
          .map(
            (d) => `
            <li>
              <a href="${d.url}">
                <div class="r-title">${escapeHtml(d.title)}</div>
                <div class="r-meta">${escapeHtml(d.category)} · ${escapeHtml(d.date)}</div>
              </a>
            </li>`,
          )
          .join('');
        empty.hidden = hits.length > 0;
      }

      function escapeHtml(s: string) {
        return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
      }

      function move(delta: number) {
        if (!list) return;
        const items = [...list.querySelectorAll('li')];
        if (!items.length) return;
        active = (active + delta + items.length) % items.length;
        items.forEach((li, i) => li.classList.toggle('is-active', i === active));
        items[active]?.scrollIntoView({ block: 'nearest' });
      }

      document.querySelector('[data-action="search-open"]')?.addEventListener('click', openSearch);
      document.querySelector('[data-role="search-backdrop"]')?.addEventListener('click', closeSearch);
      document.querySelector('[data-role="search-close"]')?.addEventListener('click', closeSearch);
      // 결과를 고르면 모달은 제 할 일을 끝냈다 — 뒤판의 잠금도 함께 풀린다.
      list?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) closeSearch(); });
      input?.addEventListener('input', () => render(input.value));

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          modal?.hidden ? openSearch() : closeSearch();
          return;
        }
        if (modal?.hidden) return;
        if (e.key === 'Escape') closeSearch();
        if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
        if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
        if (e.key === 'Enter' && active >= 0) {
          const link = list?.querySelectorAll('li')[active]?.querySelector('a');
          if (link) { e.preventDefault(); location.href = link.href; }
        }
      });
</script>
