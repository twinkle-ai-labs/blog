---
import StarMark from "./StarMark.astro";
import { AUTHOR_INFO, STUDIO_LINKS } from "../lib/site";
import s from "./StudioFooter.module.css";
import { STUDIO_APPS, STUDIO_SOCIALS } from "../lib/studio";
---

<footer class={s.footer}>
  <div class={s.shell}>
    <div class={s.top}>
      <div class={s.brand}>
        <a href="https://twinklelabs.kr/" class={s.name}
          ><span class={s.symbol}><StarMark gradientId="footer-brand" /></span>Twinkle AI Labs</a
        ><p>필요한 도구를, 좋아하는 모습으로.</p><span class={s.caption}
          >독립적으로 만들고, 직접 쓰며 다듬습니다.</span
        ><a class="footer-feed" href="/feeds/all.atom.xml">새 글 구독하기 · RSS ↗</a>
      </div>
      <nav class={s.column} aria-label="푸터 앱 목록">
        <h2>APPS</h2>{STUDIO_APPS.map((app) => <a href={app.href}>{app.name}</a>)}
      </nav>
      <nav class={s.column} aria-label="바닥글 메뉴">
        <h2>EXPLORE</h2>{
          STUDIO_LINKS.filter((link) => link.label !== "소개").map((link) => (
            <a href={link.href}>
              {link.label}
              <span aria-hidden="true">{link.href !== "/" && "↗"}</span>
            </a>
          ))
        }
      </nav>
      <div class={s.column}>
        <h2>LET’S TALK</h2><a class={s.mail} href={`mailto:${AUTHOR_INFO.email}`}
          >{AUTHOR_INFO.email}<span aria-hidden="true">↗</span></a
        ><p class={s.invitation}>앱에 대한 생각, 편하게 들려주세요.</p><nav
          class={s.social}
          aria-label="소셜 미디어"
        >
          {
            STUDIO_SOCIALS.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${link.name} (새 탭에서 열림)`}
              >
                {link.name}
                <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </nav>
      </div>
    </div>
    <div class={s.bottom}>
      <span>© {new Date().getFullYear()} Twinkle AI Labs</span><span class={s.signature}
        ><StarMark />스스로 빛나다.</span
      >
    </div>
  </div>
</footer>
