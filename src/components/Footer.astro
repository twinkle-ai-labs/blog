---
import StarMark from './StarMark.astro';
import { SITE, LINKS, STUDIO_LINKS, AUTHOR_INFO } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="footer-name" href="/"><StarMark gradientId="twinkle-footer" class="footer-mark" />{SITE.name}</a>
        <p class="footer-message">직접 만든 앱과 개발 중 해결한 문제를 기록하는 Twinkle AI Labs의 블로그입니다.</p>
        <a class="footer-feed" href="/feeds/all.atom.xml">새 글 구독하기 · RSS <span aria-hidden="true">↗</span></a>
      </div>
      <nav class="footer-column" aria-label="바닥글 메뉴">
        <p class="footer-heading">Twinkle AI Labs</p>
        <div class="footer-links">
          {STUDIO_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </nav>
      <div class="footer-column">
        <p class="footer-heading">문의와 소식</p>
        <a class="footer-mail" href={`mailto:${AUTHOR_INFO.email}`}>{AUTHOR_INFO.email}</a>
        <div class="footer-socials">
          {LINKS.filter((link) => link.name !== 'gmail').map((link) => <a href={link.url} target="_blank" rel="noopener">{link.name}</a>)}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {year} Twinkle AI Labs</p>
      <p>스스로 빛나다.</p>
    </div>
  </div>
</footer>
