---
import StarMark from './StarMark.astro';
import { SITE } from '../lib/site';

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '홈', current: path === '/' || path.startsWith('/page/') },
  { href: '/categories.html', label: '시리즈', current: path === '/categories.html' || path.startsWith('/category/') },
  { href: '/tags.html', label: '태그', current: path === '/tags.html' || path.startsWith('/tag/') },
  { href: '/archives.html', label: '아카이브', current: path === '/archives.html' },
];
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/">
      <StarMark gradientId="twinkle-brand" class="star-mark" />
      <span class="brand__name">{SITE.name}</span>
    </a>

    <nav class="site-nav" aria-label="주요 메뉴">
      {nav.map((item) => (
        <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <button type="button" class="tool-btn search-btn" data-action="search-open" aria-label="검색 열기">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="search-btn__label">검색</span>
        <kbd>⌘K</kbd>
      </button>

      <button type="button" class="tool-btn theme-toggle" data-action="theme" aria-label="테마 변경">
        <span class="icon" aria-hidden="true">☀</span>
      </button>
    </div>
  </div>
</header>
