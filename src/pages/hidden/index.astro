---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getHiddenPosts } from '../../lib/posts';

// frontmatter 에 hidden: true 를 붙인 글 — 목록·피드에는 안 실리지만 URL 은 있다 (구 사이트의 /hidden/ 유지)
const posts = await getHiddenPosts();
---

<Base title="Hidden" description="목록과 피드에는 싣지 않는 글" noindex>
  <section class="journal journal--page">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Hidden</p>
        <h1 class="section-title">숨긴 글</h1>
      </div>
      <p class="section-note">목록에는 서지 않는<br />{posts.length}개의 글</p>
    </div>

    {posts.length > 0
      ? (
        <ul class="post-list">
          {posts.map((post, index) => <PostCard post={post} headingLevel="h3" index={index + 1} />)}
        </ul>
      )
      : <p class="journal__empty">숨긴 글이 없어요.</p>}
  </section>
</Base>
