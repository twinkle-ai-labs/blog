---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getHiddenPosts } from '../../lib/posts';

// frontmatter 에 hidden: true 를 붙인 글 — 목록·피드에는 안 실리지만 URL 은 있다 (구 사이트의 /hidden/ 유지)
const posts = await getHiddenPosts();
---

<Base title="Hidden">
  <div class="page-title">
    <h1>Hidden</h1>
    <p>{posts.length ? `${posts.length}개의 숨긴 글` : '숨긴 글이 없어요.'}</p>
  </div>

  {posts.length > 0 && (
    <ul class="post-list listing">
      {posts.map((post) => <PostCard post={post} headingLevel="h3" />)}
    </ul>
  )}
</Base>
