---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getHiddenPosts } from '../../lib/posts';

// frontmatter 에 hidden: true 를 붙인 글 — 목록·피드에는 안 실리지만 URL 은 있다 (구 사이트의 /hidden/ 유지)
const posts = await getHiddenPosts();
---

<Base title="목록에서 제외한 글" description="전체 글 목록과 피드에 표시하지 않는 글입니다." noindex>
  <section class="journal journal--page">
    <div class="section-heading">
      <div>
        <p class="section-kicker">별도 보관</p>
        <h1 class="section-title">목록에서 제외한 글</h1>
      </div>
      <p class="section-note">글 {posts.length}편</p>
    </div>

    {posts.length > 0
      ? (
        <ul class="post-list">
          {posts.map((post, index) => <PostCard post={post} headingLevel="h3" index={index + 1} />)}
        </ul>
      )
      : <p class="journal__empty">목록에서 제외한 글이 없습니다.</p>}
  </section>
</Base>
