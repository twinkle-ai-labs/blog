---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getDraftPosts } from '../../lib/posts';

// frontmatter 에 draft: true 를 붙인 글이 모이는 자리 (구 사이트의 /drafts/ 유지)
const posts = await getDraftPosts();
---

<Base title="Drafts">
  <section class="journal journal--page">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Drafts</p>
        <h1 class="section-title">초안</h1>
      </div>
      <p class="section-note">아직 내보내지 않은<br />{posts.length}개의 글</p>
    </div>

    {posts.length > 0
      ? (
        <ul class="post-list">
          {posts.map((post, index) => <PostCard post={post} headingLevel="h3" index={index + 1} />)}
        </ul>
      )
      : <p class="journal__empty">아직 초안이 없어요.</p>}
  </section>
</Base>
