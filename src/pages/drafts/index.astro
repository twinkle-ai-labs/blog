---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getDraftPosts } from '../../lib/posts';

// frontmatter 에 draft: true 를 붙인 글이 모이는 자리 (구 사이트의 /drafts/ 유지)
const posts = await getDraftPosts();
---

<Base title="작성 중인 글" description="아직 작성 중인 초안입니다." noindex>
  <section class="journal journal--page">
    <div class="section-heading">
      <div>
        <p class="section-kicker">초안</p>
        <h1 class="section-title">작성 중인 글</h1>
      </div>
      <p class="section-note">글 {posts.length}편</p>
    </div>

    {posts.length > 0
      ? (
        <ul class="post-list">
          {posts.map((post, index) => <PostCard post={post} headingLevel="h3" index={index + 1} />)}
        </ul>
      )
      : <p class="journal__empty">작성 중인 글이 없습니다.</p>}
  </section>
</Base>
