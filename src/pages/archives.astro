---
import Base from '../layouts/Base.astro';
import { getPublishedPosts, postUrl, categoryOf, categoryName, formatMonthDay, type Post } from '../lib/posts';
import { blogGraph } from '../lib/jsonld';

const posts = await getPublishedPosts();
const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const span = years.length > 1 ? `${years[years.length - 1]}–${years[0]}` : `${years[0] ?? ''}`;
---

<Base
  title="모든 글"
  description={`지금까지 쓴 ${posts.length}개의 글을 해마다 모아 둔 자리`}
  jsonLd={blogGraph()}
  path="/archives.html"
>
  <section class="archive">
    <header class="archive__head">
      <p class="section-kicker">Archive</p>
      <h1 class="section-title">모든 글</h1>
      <p class="archive__count"><b>{posts.length}</b>개의 기록 · {span}</p>
    </header>

    {years.map((year) => (
      <section class="archive__year">
        <h2 class="archive__year-label">
          <span>{year}</span>
          <small>{byYear.get(year)!.length}개</small>
        </h2>
        <ol class="archive__list">
          {byYear.get(year)!.map((post) => (
            <li>
              <a href={postUrl(post)}>
                <time class="archive__date" datetime={post.data.date.toISOString()}>{formatMonthDay(post.data.date)}</time>
                <span class="archive__title">{post.data.title}</span>
                <span class="archive__cat">{categoryName(categoryOf(post))}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </section>
</Base>
