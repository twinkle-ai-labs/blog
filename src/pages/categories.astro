---
import Base from '../layouts/Base.astro';
import { getPublishedPosts, categoryOf, categoryName, seriesName, formatDate, type Post } from '../lib/posts';
import { CATEGORIES } from '../lib/site';

const posts = await getPublishedPosts();
const byCategory = new Map<string, Post[]>();
for (const post of posts) {
  const cat = categoryOf(post);
  byCategory.set(cat, [...(byCategory.get(cat) ?? []), post]);
}
const series = [...byCategory.entries()];
---

<Base title="시리즈" description={`주제별로 이어 쓰는 ${series.length}개의 글 묶음`} path="/categories.html">
  <section class="journal journal--page">
    <header class="page-heading">
      <p class="section-kicker">Series</p>
      <h1>하나의 주제를,<br /><em>조금 더 깊이.</em></h1>
      <p>앱의 첫 출시부터 작은 기술적 발견까지.<br class="desktop-only" /> 관심 있는 이야기부터 이어 읽어 보세요.</p>
      <div class="page-heading__meta">{series.length}개의 시리즈 <span aria-hidden="true">·</span> {posts.length}편의 기록</div>
    </header>
    <ul class="series-grid">
      {series.map(([cat, catPosts], index) => (
        <li>
          <a class="series-card" href={`/category/${cat}/`}>
            <div class="series-card__top"><span>{categoryName(cat)}</span><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></div>
            <h2>{seriesName(cat)}</h2>
            <p>{CATEGORIES[cat]?.description}</p>
            <div class="series-card__latest"><span>최근 기록</span><strong>{catPosts[0].data.title}</strong></div>
            <div class="series-card__bottom"><span>{catPosts.length}개의 글</span><time datetime={catPosts[0].data.date.toISOString()}>{formatDate(catPosts[0].data.date)}</time><span aria-hidden="true">↗</span></div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
