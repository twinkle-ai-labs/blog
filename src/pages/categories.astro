---
import Base from '../layouts/Base.astro';
import { getPublishedPosts, categoryOf, categoryName, seriesName, formatDate, type Post } from '../lib/posts';
import { CATEGORIES } from '../lib/site';

const posts = await getPublishedPosts();
const byCategory = new Map<string, Post[]>();
for (const post of posts) {
  const cat = categoryOf(post);
  byCategory.set(cat, [...(byCategory.get(cat) ?? []), post]);
}
const series = [...byCategory.entries()];
---

<Base title="시리즈" description={`앱 출시부터 개발 도구까지, ${series.length}개의 시리즈로 나누어 읽는 개발 기록입니다.`} path="/categories.html">
  <section class="journal journal--page">
    <header class="page-heading">
      <p class="section-kicker">시리즈</p>
      <h1>궁금한 주제부터<br /><em>이어 읽으세요.</em></h1>
      <p>앱을 출시한 과정과 개발 중 해결한 문제를 주제별로 모았습니다.<br class="desktop-only" /> 각 시리즈에서 관련 글을 한 번에 살펴볼 수 있습니다.</p>
      <div class="page-heading__meta">시리즈 {series.length}개 <span aria-hidden="true">·</span> 글 {posts.length}편</div>
    </header>
    <ul class="series-grid">
      {series.map(([cat, catPosts], index) => (
        <li>
          <a class="series-card" href={`/category/${cat}/`}>
            <div class="series-card__top"><span>{categoryName(cat)}</span><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></div>
            <h2>{seriesName(cat)}</h2>
            <p>{CATEGORIES[cat]?.description}</p>
            <div class="series-card__latest"><span>이 시리즈의 최신 글</span><strong>{catPosts[0].data.title}</strong></div>
            <div class="series-card__bottom"><span>글 {catPosts.length}편</span><time datetime={catPosts[0].data.date.toISOString()}>{formatDate(catPosts[0].data.date)}</time><span aria-hidden="true">↗</span></div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
