---
import Base from '../layouts/Base.astro';
import { getPublishedPosts, categoryOf, seriesName, type Post } from '../lib/posts';
import { CATEGORIES } from '../lib/site';

const posts = await getPublishedPosts();
const byCategory = new Map<string, Post[]>();
for (const post of posts) {
  const cat = categoryOf(post);
  byCategory.set(cat, [...(byCategory.get(cat) ?? []), post]);
}
const series = [...byCategory.entries()];
---

<Base title="시리즈">
  <section class="journal journal--page">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Series</p>
        <h1 class="section-title">시리즈</h1>
      </div>
      <p class="section-note">주제별로 이어 쓰는<br />{series.length}개의 글 묶음</p>
    </div>

    <ul class="post-list">
      {series.map(([cat, catPosts], index) => (
        <li>
          <a class="post-card" href={`/category/${cat}/`}>
            <span class="post-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="post-card__content">
              <div class="post-card__meta">
                <span class="chip chip--brand">시리즈</span>
                <span>{catPosts.length}개의 글</span>
              </div>
              <h2>{seriesName(cat)}</h2>
              {CATEGORIES[cat]?.description && <p class="post-card__summary">{CATEGORIES[cat].description}</p>}
            </div>
            <span class="arrow" aria-hidden="true">보기 <b>↗</b></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
