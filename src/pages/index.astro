---
import Base from '../layouts/Base.astro';
import StarMark from '../components/StarMark.astro';
import Starfield from '../components/Starfield.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { getPublishedPosts } from '../lib/posts';
import { PAGE_SIZE, SITE } from '../lib/site';
import { blogGraph } from '../lib/jsonld';

const posts = await getPublishedPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const pagePosts = posts.slice(0, PAGE_SIZE);
---

<Base
  description={`${SITE.description} 지금까지 ${posts.length}편.`}
  jsonLd={blogGraph()}
>
  <section class="hero">
    <Starfield seed={20260822} height="35rem" dots={72} sparkles={9} shooting={1} keepout={{ x: [18, 82], y: [14, 90] }} />
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__intro">
      <div class="hero__badge"><StarMark gradientId="twinkle-hero" class="hero__mark" /><span>Twinkle Dev Journal</span></div>
      <h1 class="hero__title">작은 발견이<br /><em>오래 빛나는 기록</em>이 되도록.</h1>
      <p class="hero__lead">만들고, 실패하고, 다시 다듬으며 배운 것들을<br class="desktop-only" /> 솔직하고 다정한 언어로 기록합니다.</p>
      <div class="hero__links">
        <a class="btn-cta" href="#recent">새로운 이야기 읽기 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="journal" id="recent">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Latest journal</p>
        <h2 class="section-title">최근의 기록</h2>
      </div>
      <p class="section-note">경험에서 건져 올린<br />{posts.length}개의 작은 빛</p>
    </div>

    {pagePosts.length > 0 && (
      <ul class="post-list">
        {pagePosts.map((post, index) => <PostCard post={post} headingLevel="h3" index={index + 1} />)}
      </ul>
    )}
  </section>

  <Pagination current={1} total={totalPages} />
</Base>
