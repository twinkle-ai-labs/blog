---
import Base from '../layouts/Base.astro';
import StarMark from '../components/StarMark.astro';
import Starfield from '../components/Starfield.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { getPublishedPosts } from '../lib/posts';
import { SITE, LINKS, PAGE_SIZE } from '../lib/site';

const posts = await getPublishedPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const pagePosts = posts.slice(0, PAGE_SIZE);
---

<Base>
  <section class="hero">
    {/* 첫 화면의 하늘 — 글이 서는 가운데는 비워 둔다. */}
    <Starfield seed={20260822} height="30rem" dots={64} sparkles={7} shooting={1} keepout={{ x: [24, 76], y: [10, 92] }} />
    <div class="hero__intro">
      <StarMark gradientId="twinkle-hero" class="hero__mark" />
      <p class="eyebrow">Dev Blog</p>
      <h1 class="hero__title">기록이 빛이 되는 곳,<br />{SITE.name}</h1>
      <p class="hero__lead">{SITE.description}</p>
      <div class="hero__links">
        <a class="btn-cta" href="#recent">최근 글 보기</a>
        {LINKS.map((link) => (
          <a class="btn-ghost" href={link.url} target="_blank" rel="noopener">{link.name}</a>
        ))}
      </div>
    </div>
  </section>

  <h2 class="section-title" id="recent">최근 글 <span class="count">{posts.length}개의 글</span></h2>
  <ul class="post-list">
    {pagePosts.map((post) => <PostCard post={post} headingLevel="h3" />)}
  </ul>

  <Pagination current={1} total={totalPages} />
</Base>
