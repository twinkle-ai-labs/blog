---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { getPublishedPosts, categoryOf, categoryName, seriesName, postUrl, formatDate, readingMinutesOf } from '../lib/posts';
import { PAGE_SIZE, SITE } from '../lib/site';
import { blogGraph } from '../lib/jsonld';

const posts = await getPublishedPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const [latest, ...pagePosts] = posts.slice(0, PAGE_SIZE);
const categories = [...new Set(posts.map(categoryOf))].map((slug) => ({
  slug, count: posts.filter((post) => categoryOf(post) === slug).length,
}));
---

<Base description={`${SITE.description} 글 ${posts.length}편을 읽을 수 있습니다.`} jsonLd={blogGraph()}>
  <section class="journal-hero" aria-labelledby="journal-title">
    <div class="journal-hero__intro">
      <p class="section-kicker">개발 기록</p>
      <h1 id="journal-title">직접 만들고,<br /><em>겪은 것을 씁니다.</em></h1>
      <p class="journal-hero__lead">앱을 기획하고 출시하며 마주친 문제들.<br class="desktop-only" /> 무엇이 막혔고 어떻게 풀었는지 기록합니다.</p>
      <div class="journal-hero__links">
        <a class="text-link" href="/archives.html">전체 글 보기 <span aria-hidden="true">↗</span></a>
        <span>글 {posts.length}편 · 시리즈 {categories.length}개</span>
      </div>
    </div>
    {latest && (
      <a class="featured-post" href={postUrl(latest)}>
        <div class="featured-post__top"><span class="section-kicker">새 글</span><span aria-hidden="true">↗</span></div>
        <span class="featured-post__category">{categoryName(categoryOf(latest))}</span>
        <h2>{latest.data.title}</h2>
        <p>{latest.data.summary}</p>
        <div class="featured-post__meta"><time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time><span>약 {readingMinutesOf(latest)}분</span></div>
      </a>
    )}
  </section>

  <div class="journal-layout">
    <section class="journal" id="recent" aria-labelledby="recent-title">
      <div class="section-heading">
        <div><p class="section-kicker">이어서 읽기</p><h2 class="section-title" id="recent-title">최근 글</h2></div>
        <a class="text-link" href="/archives.html">전체 글 보기 <span aria-hidden="true">↗</span></a>
      </div>
      {pagePosts.length > 0 ? (
        <ul class="post-list">{pagePosts.map((post, index) => <PostCard post={post} headingLevel="h3" index={index + 2} />)}</ul>
      ) : <p class="journal__empty">아직 다른 글이 없습니다.</p>}
      <Pagination current={1} total={totalPages} />
    </section>

    <aside class="journal-aside" aria-label="더 읽어보기">
      <section class="explore-series">
        <div class="aside-heading"><h2>시리즈 모아보기</h2><a href="/categories.html" aria-label="전체 시리즈 보기">↗</a></div>
        <ul>{categories.map(({slug, count}) => (
          <li><a href={`/category/${slug}/`}><span>{seriesName(slug)}</span><small>{count}편</small></a></li>
        ))}</ul>
      </section>
      <section class="journal-about">
        <p class="section-kicker">Twinkle AI Labs</p>
        <h2>글에 담긴 앱이<br />궁금하다면.</h2>
        <p>물타기 계산기와 Pocket PDF 등 직접 만든 앱을 살펴보세요.</p>
        <a class="text-link" href="https://twinklelabs.kr/app/">앱 둘러보기 <span aria-hidden="true">↗</span></a>
      </section>
      <a class="feed-link" href="/feeds/all.atom.xml">새 글 구독하기 · RSS <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</Base>
