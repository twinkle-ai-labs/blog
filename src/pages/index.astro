---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { getPublishedPosts, categoryOf, categoryName, seriesName, postUrl, formatDate, readingMinutesOf } from '../lib/posts';
import { PAGE_SIZE, SITE } from '../lib/site';
import { blogGraph } from '../lib/jsonld';

const posts = await getPublishedPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const [latest, ...pagePosts] = posts.slice(0, PAGE_SIZE);
const categories = [...new Set(posts.map(categoryOf))].map((slug) => ({
  slug, count: posts.filter((post) => categoryOf(post) === slug).length,
}));
---

<Base description={`${SITE.description} 지금까지 ${posts.length}편.`} jsonLd={blogGraph()}>
  <section class="journal-hero" aria-labelledby="journal-title">
    <div class="journal-hero__intro">
      <p class="section-kicker">Twinkle Dev Journal</p>
      <h1 id="journal-title">만들며 배운 것을<br /><em>기록합니다.</em></h1>
      <p class="journal-hero__lead">앱을 만들고, 작은 문제를 풀고, 다시 다듬는 과정.<br class="desktop-only" /> 그 안에서 발견한 생각과 기술을 나눕니다.</p>
      <div class="journal-hero__links">
        <a class="text-link" href="/archives.html">모든 글 <span aria-hidden="true">↗</span></a>
        <span>{posts.length}편의 기록 · {categories.length}개의 시리즈</span>
      </div>
    </div>
    {latest && (
      <a class="featured-post" href={postUrl(latest)}>
        <div class="featured-post__top"><span class="section-kicker">새로 쓴 글</span><span aria-hidden="true">↗</span></div>
        <span class="featured-post__category">{categoryName(categoryOf(latest))}</span>
        <h2>{latest.data.title}</h2>
        <p>{latest.data.summary}</p>
        <div class="featured-post__meta"><time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time><span>{readingMinutesOf(latest)}분 읽기</span></div>
      </a>
    )}
  </section>

  <div class="journal-layout">
    <section class="journal" id="recent" aria-labelledby="recent-title">
      <div class="section-heading">
        <div><p class="section-kicker">Latest stories</p><h2 class="section-title" id="recent-title">최근의 기록</h2></div>
        <a class="text-link" href="/archives.html">전체 보기 <span aria-hidden="true">↗</span></a>
      </div>
      {pagePosts.length > 0 ? (
        <ul class="post-list">{pagePosts.map((post, index) => <PostCard post={post} headingLevel="h3" index={index + 2} />)}</ul>
      ) : <p class="journal__empty">새로운 이야기를 준비하고 있습니다.</p>}
      <Pagination current={1} total={totalPages} />
    </section>

    <aside class="journal-aside" aria-label="더 읽어보기">
      <section class="explore-series">
        <div class="aside-heading"><h2>시리즈로 읽기</h2><a href="/categories.html" aria-label="모든 시리즈 보기">↗</a></div>
        <ul>{categories.map(({slug, count}) => (
          <li><a href={`/category/${slug}/`}><span>{seriesName(slug)}</span><small>{count}</small></a></li>
        ))}</ul>
      </section>
      <section class="journal-about">
        <p class="section-kicker">Behind the work</p>
        <h2>한 사람과 AI가<br />제품을 만드는 이야기.</h2>
        <p>Twinkle AI Labs에서 만든 앱과 그 뒤의 시행착오를 함께 기록합니다.</p>
        <a class="text-link" href="https://twinklelabs.kr/app/">만든 앱 둘러보기 <span aria-hidden="true">↗</span></a>
      </section>
      <a class="feed-link" href="/feeds/all.atom.xml">RSS로 새 글 받아보기 <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</Base>
