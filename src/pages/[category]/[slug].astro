---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import {
  getPublishedPosts,
  postUrl,
  categoryOf,
  categoryName,
  seriesName,
  formatDate,
  slugify,
  type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  // 공개 글끼리만 이전/다음으로 잇는다. draft/hidden 도 URL 자체는 만들어 둔다(Pelican과 동일).
  const published = await getPublishedPosts();
  const all = await getCollection('blog');

  return all.map((post) => {
    const index = published.findIndex((p) => p.id === post.id);
    return {
      params: { category: categoryOf(post), slug: post.data.slug },
      props: {
        post,
        // published 는 최신순 — 다음 글(newer)은 앞, 이전 글(older)은 뒤
        newer: index > 0 ? published[index - 1] : null,
        older: index >= 0 && index < published.length - 1 ? published[index + 1] : null,
      },
    };
  });
}

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth <= 3);
const category = categoryOf(post);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const readingMinutes = Math.max(1, Math.ceil(post.body.trim().split(/\s+/).length / 260));
const seriesPosts = (await getPublishedPosts())
  .filter((entry) => categoryOf(entry) === category)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const seriesIndex = seriesPosts.findIndex((entry) => entry.id === post.id);
const seriesTitle = seriesName(category);
---

<Base title={post.data.title} description={post.data.summary} article lang={post.data.lang}>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <article>
    <header class="article-header">
      <a class="article-back" href="/archives.html"><span aria-hidden="true">←</span> 모든 글</a>
      <div class="article-header__meta">
        <a class="chip chip--brand" href={`/category/${category}/`}>{categoryName(category)}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>·</span>
        <span>{readingMinutes}분 읽기</span>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.summary && <p class="article-summary">{post.data.summary}</p>}
      {post.data.tags.length > 0 && (
        <div class="article-header__tags">
          {post.data.tags.map((tag) => (
            <a class="chip" href={`/tag/${slugify(tag)}/`}>#{slugify(tag)}</a>
          ))}
        </div>
      )}
      <div class="article-author">
        <span class="article-author__mark" aria-hidden="true">✦</span>
        <span><b>{post.data.author}</b><small>Twinkle AI Labs</small></span>
      </div>
    </header>

    {seriesPosts.length > 1 && (
      <nav class="series-nav" aria-label={`${seriesTitle} 시리즈`}>
        <div class="series-nav__heading">
          <div><span>Series</span><h2>{seriesTitle}</h2></div>
          <p>{seriesIndex + 1} / {seriesPosts.length}</p>
        </div>
        <ol>
          {seriesPosts.map((entry, index) => (
            <li class:list={{ 'is-current': entry.id === post.id, 'is-past': index < seriesIndex }}>
              <a href={postUrl(entry)} aria-current={entry.id === post.id ? 'page' : undefined}>
                <span class="series-nav__number">{String(index + 1).padStart(2, '0')}</span>
                <span class="series-nav__title">{entry.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <hr class="article-divider" />

    <div class:list={['article-grid', { 'article-grid--with-toc': toc.length > 1 }]}>
      <div>
        <div class="prose">
          <Content />
        </div>

        {(older || newer) && (
          <nav class="post-nav" aria-label="이전/다음 글">
            {older ? (
              <a class="post-nav__card" href={postUrl(older)} rel="prev">
                <span class="post-nav__label">
                  <span class="post-nav__arrow" aria-hidden="true">←</span> 이전 글
                </span>
                <span class="post-nav__title">{older.data.title}</span>
                <span class="post-nav__series">{seriesName(categoryOf(older))}</span>
              </a>
            ) : (
              <span class="post-nav__blank" aria-hidden="true"></span>
            )}
            {newer ? (
              <a class="post-nav__card post-nav__card--next" href={postUrl(newer)} rel="next">
                <span class="post-nav__label">
                  다음 글 <span class="post-nav__arrow" aria-hidden="true">→</span>
                </span>
                <span class="post-nav__title">{newer.data.title}</span>
                <span class="post-nav__series">{seriesName(categoryOf(newer))}</span>
              </a>
            ) : (
              <span class="post-nav__blank" aria-hidden="true"></span>
            )}
          </nav>
        )}

        <Comments canonical={canonical} identifier={Astro.url.pathname} />

      </div>

      {toc.length > 1 && (
        <nav class="toc" aria-label="목차">
          <div class="toc__title">On this page</div>
          <ul>
            {toc.map((heading) => (
              <li data-depth={heading.depth}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </article>

  <script>
    const progress = document.querySelector<HTMLElement>('.reading-progress span');
    const updateProgress = () => {
      if (!progress) return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
    };
    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });

    // 스크롤 위치에 맞춰 TOC 하이라이트
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    if (tocLinks.length) {
      const map = new Map<Element, HTMLAnchorElement>();
      for (const link of tocLinks) {
        const id = decodeURIComponent(link.hash.slice(1));
        const target = document.getElementById(id);
        if (target) map.set(target, link);
      }
      let current: HTMLAnchorElement | null = null;
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              current?.classList.remove('is-active');
              current = map.get(entry.target) ?? null;
              current?.classList.add('is-active');
            }
          }
        },
        { rootMargin: '-72px 0px -70% 0px' },
      );
      for (const target of map.keys()) observer.observe(target);
    }
  </script>
</Base>
