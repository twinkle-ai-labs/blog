---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import Comments from '../../components/Comments.astro';
import PostNav from '../../components/PostNav.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import Toc from '../../components/Toc.astro';
import { getPublishedPosts, postUrl, categoryOf, type Post } from '../../lib/posts';
import { postGraph } from '../../lib/jsonld';
import { ogImageOf } from '../../lib/share';

export async function getStaticPaths() {
  // 공개 글끼리만 이전/다음으로 잇는다. draft/hidden 도 URL 자체는 만들어 둔다(Pelican과 동일).
  const published = await getPublishedPosts();
  const all = await getCollection('blog');

  return all.map((post) => {
    const index = published.findIndex((p) => p.id === post.id);
    return {
      params: { category: categoryOf(post), slug: post.data.slug },
      props: {
        post,
        // published 는 최신순 — 다음 글(newer)은 앞, 이전 글(older)은 뒤
        newer: index > 0 ? published[index - 1] : null,
        older: index >= 0 && index < published.length - 1 ? published[index + 1] : null,
      },
    };
  });
}

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

/**
 * 글 한 편 — **차례만** 든다.
 *
 * 머리·시리즈 목차·이전다음·목차·진행 막대가 저마다 제 조각을 가지므로,
 * 이 파일은 「무엇이 어떤 순서로 서는가」와 조각들이 스스로 알 수 없는 것
 * (이웃 글 — 전체 목록은 getStaticPaths 에만 있다)만 말한다.
 */
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
/* 어느 깊이까지 목차에 실을지는 페이지의 사정 — 본문 옆 한 칸에 h4 까지 서면 목차가 본문만큼 길어진다. */
const toc = headings.filter((h) => h.depth <= 3);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
/* 이 글의 나눔 카드 — 어디 서는지는 lib/share 한 벌이 정한다. */
const ogImage = ogImageOf(post);
/* 초안과 숨긴 글은 주소는 있어도 아직 보일 것이 아니다 — 목록에 올리지 않는다. */
const isUnlisted = post.data.draft || post.data.hidden;
---

<Base
  title={post.data.title}
  description={post.data.summary}
  article
  lang={post.data.lang}
  image={ogImage}
  noindex={isUnlisted}
  published={post.data.date}
  author={post.data.author}
  tags={post.data.tags}
  jsonLd={postGraph(post, ogImage)}
  path={postUrl(post)}
>
  <ReadingProgress />
  <article>
    <ArticleHeader post={post} />
    <SeriesNav post={post} />

    <hr class="article-divider" />

    <div class:list={['article-grid', { 'article-grid--with-toc': toc.length > 1 }]}>
      <div>
        <div class="prose">
          <Content />
        </div>

        <PostNav newer={newer} older={older} />

        <Comments canonical={canonical} identifier={Astro.url.pathname} />
      </div>

      <Toc toc={toc} />
    </div>
  </article>
</Base>
