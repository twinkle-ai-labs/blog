---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, categoryOf, categoryName, type Post } from '../../../lib/posts';
import { CATEGORIES } from '../../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = [...new Set(posts.map(categoryOf))];
  return categories.map((cat) => ({
    params: { cat },
    props: { cat, posts: posts.filter((p) => categoryOf(p) === cat) },
  }));
}

interface Props {
  cat: string;
  posts: Post[];
}

const { cat, posts } = Astro.props;
const seriesTitle = cat === 'stock-calculator' ? '첫 앱 출시기' : categoryName(cat);
---

<Base title={`${seriesTitle} 시리즈`} description={CATEGORIES[cat]?.description}>
  <section class="journal series-listing">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Series · {posts.length} stories</p>
        <h1 class="section-title">{seriesTitle}</h1>
      </div>
      <p class="section-note">{CATEGORIES[cat]?.description ?? `${categoryName(cat)} 카테고리의 글`}</p>
    </div>

    {posts.length > 0 && (
      <ul class="post-list">
        {posts.map((post, index) => <PostCard post={post} headingLevel="h3" index={index + 1} />)}
      </ul>
    )}
  </section>
</Base>
