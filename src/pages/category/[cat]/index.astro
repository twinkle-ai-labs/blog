---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, categoryOf, seriesName, type Post } from '../../../lib/posts';
import { CATEGORIES } from '../../../lib/site';
import { seriesGraph } from '../../../lib/jsonld';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = [...new Set(posts.map(categoryOf))];
  return categories.map((cat) => ({
    params: { cat },
    props: { cat, posts: posts.filter((p) => categoryOf(p) === cat) },
  }));
}

interface Props {
  cat: string;
  posts: Post[];
}

const { cat, posts } = Astro.props;
const seriesTitle = seriesName(cat);
const blurb = CATEGORIES[cat]?.description ?? `${seriesTitle}에 관한 글을 모았습니다.`;
---

<Base title={`${seriesTitle} 시리즈`} description={`${seriesTitle} — ${blurb}`} jsonLd={seriesGraph(cat, posts)}>
  <section class="journal journal--page series-listing">
    <a class="listing-back" href="/categories.html"><span aria-hidden="true">←</span> 전체 시리즈</a>
    <div class="section-heading">
      <div>
        <p class="section-kicker">시리즈</p>
        <h1 class="section-title">{seriesTitle}</h1>
      </div>
      <p class="section-note">{blurb}</p>
    </div>
    <div class="listing-caption"><span>글 {posts.length}편</span><span>최신순</span></div>

    {posts.length > 0 && (
      <ul class="post-list">
        {posts.map((post, index) => <PostCard post={post} headingLevel="h2" index={index + 1} />)}
      </ul>
    )}
  </section>
</Base>
