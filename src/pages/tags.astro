---
import Base from '../layouts/Base.astro';
import { getPublishedPosts, collectTags } from '../lib/posts';

const tags = collectTags(await getPublishedPosts());
---

<Base title="태그 모음">
  <div class="page-title">
    <h1>태그 모음</h1>
    <p>{tags.length}개의 태그</p>
  </div>

  <div class="tag-cloud">
    {tags.map((info) => (
      <a class="chip" href={`/tag/${info.slug}/`}>
        #{info.slug}<span class="n">{info.posts.length}</span>
      </a>
    ))}
  </div>
</Base>
