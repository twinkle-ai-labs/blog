---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, collectTags, type TagInfo } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return collectTags(posts).map((info) => ({
    params: { tag: info.slug },
    props: { info },
  }));
}

interface Props {
  info: TagInfo;
}

const { info } = Astro.props;
---

<Base
  title={`#${info.slug} 태그`}
  description={`«${info.tag}» 를 다룬 ${info.posts.length}개의 글`}
>
  <section class="journal journal--page">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Tagged</p>
        <h1 class="section-title">#{info.slug}</h1>
      </div>
      <p class="section-note">이 주제로 쓴<br />{info.posts.length}개의 글</p>
    </div>

    <ul class="post-list">
      {info.posts.map((post, index) => <PostCard post={post} headingLevel="h3" index={index + 1} />)}
    </ul>
  </section>
</Base>
