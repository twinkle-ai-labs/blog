---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPublishedPosts, type Post } from '../../../lib/posts';
import { PAGE_SIZE } from '../../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
  // 1페이지는 / 가 담당한다 — 구 Pelican PAGINATION_PATTERNS 그대로
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        posts: posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
      },
    };
  });
}

interface Props {
  page: number;
  totalPages: number;
  posts: Post[];
}

const { page, totalPages, posts } = Astro.props;
// 번호는 페이지마다 01 로 돌아가지 않는다 — 홈에서 세던 순서를 이어 받는다.
const offset = (page - 1) * PAGE_SIZE;
---

<Base title={`글 목록 ${page}페이지`}>
  <section class="journal journal--page">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Latest journal</p>
        <h1 class="section-title">최근의 기록</h1>
      </div>
      <p class="section-note">{page} / {totalPages} 페이지</p>
    </div>

    <ul class="post-list">
      {posts.map((post, index) => <PostCard post={post} headingLevel="h3" index={offset + index + 1} />)}
    </ul>
  </section>

  <Pagination current={page} total={totalPages} />
</Base>
