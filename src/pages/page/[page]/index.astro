---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPublishedPosts, type Post } from '../../../lib/posts';
import { PAGE_SIZE } from '../../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
  // 1페이지는 / 가 담당한다 — 구 Pelican PAGINATION_PATTERNS 그대로
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        posts: posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
      },
    };
  });
}

interface Props {
  page: number;
  totalPages: number;
  posts: Post[];
}

const { page, totalPages, posts } = Astro.props;
---

<Base title={`글 목록 ${page}페이지`}>
  <div class="page-title">
    <h1>글 목록</h1>
    <p>{page} / {totalPages} 페이지</p>
  </div>

  <ul class="post-list listing">
    {posts.map((post) => <PostCard post={post} headingLevel="h3" />)}
  </ul>

  <Pagination current={page} total={totalPages} />
</Base>
